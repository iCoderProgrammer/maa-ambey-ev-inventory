# Browser-visible settings ONLY. Every VITE_* value is bundled into public
# JavaScript: never put secrets, tokens or database credentials here.

# Base URL for the Go API. Keep "/api/v1" to use the Vite dev proxy (no CORS
# needed). An absolute URL such as http://localhost:8080/api/v1 also works if
# the API's CORS_ALLOWED_ORIGINS includes this UI's origin.
VITE_API_BASE_URL=/api/v1

# Dev-server only (not exposed to the browser): where Vite proxies /api and /swagger.
API_PROXY_TARGET=http://localhost:8080
