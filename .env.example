# ─────────────────────────────────────────────────────────────
# Maa Ambey Enterprises — backend (Go API) + Docker Compose env
# Copy to .env (git-ignored) and adjust. Example values only:
# never commit real credentials.
# ─────────────────────────────────────────────────────────────

# Optional: unique Docker Compose project name when running a second checkout on one machine
# (default project is maa-ambey-inventory; same name = shared container and volume).
# COMPOSE_PROJECT_NAME=maa-ambey-inventory

# development | test | staging | production
APP_ENV=development
APP_PORT=8080

# PostgreSQL container (docker-compose.yml reads these)
POSTGRES_USER=app_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=maa_ambey_inventory
POSTGRES_HOST_PORT=5432

# Must match the values above when using the Compose database.
# Production must use sslmode=require (or stricter); startup rejects sslmode=disable.
DATABASE_URL=postgres://app_user:change_me@localhost:5432/maa_ambey_inventory?sslmode=disable
DB_MAX_CONNS=10
DB_MIN_CONNS=1
DB_MAX_CONN_LIFETIME=1h
DB_MAX_CONN_IDLE_TIME=30m

# Comma-separated explicit origins. "*" is rejected.
# Not needed when the UI uses the Vite proxy (VITE_API_BASE_URL=/api/v1).
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Comma-separated proxy IPs/CIDRs allowed to set X-Forwarded-For. Empty = trust none.
TRUSTED_PROXIES=

# debug | info | warn | error
LOG_LEVEL=debug

REQUEST_TIMEOUT=15s
SHUTDOWN_TIMEOUT=20s

# Per-client-IP limit on /api/v1
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40

# Swagger UI at /swagger/index.html. Defaults to true outside production.
SWAGGER_ENABLED=true

# Sessions and sign-in (B-06). Values are proposals pending owner sign-off.
# Idle = ends after this long without activity; absolute = ends this long after sign-in.
SESSION_IDLE_TIMEOUT=2h
SESSION_ABSOLUTE_TIMEOUT=12h
# Secure (HTTPS-only, __Host- prefixed) cookie. Defaults to false only for development/test;
# staging and production refuse to start with false.
SESSION_COOKIE_SECURE=false
# Failed sign-ins allowed per username+IP and per IP within the window before 429.
LOGIN_MAX_FAILURES=5
LOGIN_MAX_FAILURES_PER_IP=20
LOGIN_FAILURE_WINDOW=15m

# Role-based access (B-07). Only owner-APPROVED grants count. true = PROPOSED (unapproved)
# grants count too, so features can be tried locally before the owner signs off the
# permission matrix. Local development only (APP_ENV=development): any other APP_ENV refuses to start with true.
RBAC_ALLOW_PROPOSED_GRANTS=false

# Private attachments (B-09). Files are stored privately and served only through the API
# after a permission check, via short-lived links signed for one user. Never a public URL.
# local = private directory on the API host (the only driver until the object-storage
# provider is chosen). Development/test default: var/attachments (git-ignored);
# staging/production must set an absolute path outside any web root.
ATTACHMENT_STORAGE_DRIVER=local
ATTACHMENT_STORAGE_DIR=var/attachments
# Per-file limit in bytes (proposal: 10 MB, max 25 MB). Accepted types: JPEG, PNG, WebP, PDF.
ATTACHMENT_MAX_BYTES=10485760
# Download-link lifetime (30s–15m).
ATTACHMENT_LINK_TTL=5m
# HMAC key for download links, at least 32 characters. Required in staging/production;
# empty in development/test = random per start (links stop working after a restart).
ATTACHMENT_SIGNING_KEY=
